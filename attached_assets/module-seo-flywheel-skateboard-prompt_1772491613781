# Pseudocode — SEO Flywheel Skateboard ## Data model (SQLite) TABLE pages( url PRIMARY KEY, last_seen_at, last_published_at, content_hash, cooldown_until ) TABLE gsc( page, query, impressions, clicks, position, date_range, PRIMARY KEY(page, query, date_range) ) TABLE actions( id PRIMARY KEY AUTOINCREMENT, created_at, type, # ingest | select | plan | publish | measure page_url, status, # queued | started | done | skipped | error payload_json, result_json ) TABLE baselines( page_url, date_range, baseline_impressions, baseline_clicks, baseline_position, baseline_taken_at, PRIMARY KEY(page_url, date_range) ) ## Main loop (daily) FUNCTION RUN_DAILY(date_range): INIT_DB() ACTION_LOG(type="ingest", status="started") rows = GSC_ADAPTER.LOAD_ROWS(date_range) DB.UPSERT_GSC(rows, date_range) ACTION_LOG(type="ingest", status="done", result={row_count}) ACTION_LOG(type="select", status="started") opps = SELECT_NEAR_WINS(date_range) ACTION_LOG(type="select", status="done", result={opps_count}) FOR opp IN opps LIMIT MAX_PAGES_PER_RUN: IF PAGE_IN_COOLDOWN(opp.page): ACTION_LOG(type="plan", page=opp.page, status="skipped", result={"reason":"cooldown"}) CONTINUE content = CMS_ADAPTER.FETCH_PAGE(opp.page) before_hash = HASH(content) IF before_hash == DB.pages.content_hash AND RECENTLY_PUBLISHED(opp.page): ACTION_LOG(type="plan", page=opp.page, status="skipped", result={"reason":"unchanged"}) CONTINUE related = DB.GET_TOP_QUERIES_FOR_PAGE(date_range, opp.page) ACTION_LOG(type="plan", page=opp.page, status="started", payload={opp, related_top_n}) plan = LLM.GENERATE_REFRESH_PLAN(page_url=opp.page, content=content, primary_query=opp.query, related_queries=related) IF NOT VALIDATE(plan): ACTION_LOG(type="plan", page=opp.page, status="error", result={"reason":"invalid_plan"}) SET_COOLDOWN(opp.page, short) CONTINUE ACTION_LOG(type="plan", page=opp.page, status="done", result={"plan_summary":plan.summary}) new_content = APPLY_PLAN(content, plan) after_hash = HASH(new_content) IF after_hash == before_hash: ACTION_LOG(type="publish", page=opp.page, status="skipped", result={"reason":"no_change"}) CONTINUE IF DIFF_TOO_LARGE(content, new_content): # Skateboard guardrail: safer to PR or todo mode IF MODE == "pr": pr = CMS_ADAPTER.OPEN_PR(opp.page, new_content, plan) ACTION_LOG(type="publish", page=opp.page, status="done", result={"mode":"pr","pr":pr}) ELSE: TODO_QUEUE.ADD("Review large diff", page=opp.page, plan=plan) ACTION_LOG(type="publish", page=opp.page, status="skipped", result={"mode":"todo","reason":"diff_too_large"}) SET_COOLDOWN(opp.page, medium) CONTINUE # record baseline if missing (for later uplift) IF NOT DB.BASELINE_EXISTS(opp.page, date_range): DB.INSERT_BASELINE(opp.page, date_range, metrics_from_gsc(opp)) # publish ACTION_LOG(type="publish", page=opp.page, status="started") result = CMS_ADAPTER.PUBLISH_UPDATE(opp.page, new_content, plan) DB.UPDATE_PAGE_HASH(opp.page, after_hash) DB.SET_LAST_PUBLISHED(opp.page, now) SET_COOLDOWN(opp.page, medium) ACTION_LOG(type="publish", page=opp.page, status="done", result=result) DASHBOARD_METRICS.RECOMPUTE_SUMMARIES() RETURN OK ## Weekly loop (measure uplift) FUNCTION RUN_WEEKLY_MEASURE(date_range_current, date_range_baseline): INIT_DB() ACTION_LOG(type="measure", status="started") rows = GSC_ADAPTER.LOAD_ROWS(date_range_current) DB.UPSERT_GSC(rows, date_range_current) FOR baseline IN DB.GET_BASELINES(date_range_baseline): current = DB.GET_PAGE_METRICS(date_range_current, baseline.page_url) uplift = COMPUTE_UPLIFT(baseline, current) DB.STORE_UPLIFT(baseline.page_url, uplift) ACTION_LOG(type="measure", status="done") DASHBOARD_METRICS.RECOMPUTE_SUMMARIES() RETURN OK ## Opportunity selection (near-wins) FUNCTION SELECT_NEAR_WINS(date_range): candidates = DB.QUERY( WHERE impressions >= MIN_IMPRESSIONS AND position BETWEEN POS_MIN AND POS_MAX ORDER BY impressions DESC ) # dedupe: pick best query per page best_by_page = {} FOR c IN candidates: IF c.page NOT IN best_by_page OR c.impressions > best_by_page[c.page].impressions: best_by_page[c.page] = c RETURN SORT_DESC(best_by_page.values(), key=impressions) ## Dashboard endpoint FUNCTION DASHBOARD_HANDLER(): last_run = DB.GET_LAST_ACTION(type="ingest" OR "publish") counts = DB.GET_ACTION_COUNTS(last_7_days) top_uplifts = DB.GET_TOP_UPLIFTS(limit=10) errors = DB.GET_RECENT_ERRORS(limit=20) RENDER_PAGE({ last_run, counts, top_uplifts, errors, queue_health }) 

ops/runbook.md

# Runbook — SEO Flywheel Skateboard ## Modes - `stub`: does everything except publishing (safe dry-run) - `todo`: creates tasks for user review - `pr`: opens PRs with proposed changes - `publish`: updates CMS directly ## Daily cadence (recommended) - Run controller daily (off-peak) - Process MAX_PAGES_PER_RUN = 3–10 - Cooldown per page: 7 days (default) ## Weekly cadence - Run measure job weekly to compute uplift. ## Failure handling - If GSC adapter fails → create todo: “Export GSC file and upload” - If CMS adapter fails → fall back to PR mode - If LLM plan invalid → short cooldown, log error, skip ## Quality gates - Plan must include: - title OR h1 adjustment suggestion - >= 1 section to add - >= 3 related queries used as evidence - Diff size max threshold (configurable) ## Observability checks - Dashboard shows: - last run timestamp - processed vs skipped counts - error list - top uplift pages ## Manual override - Pin a page to refresh next run (optional config list) - Exclude pages (regex list) 

ops/upgrade-gates.md (upgrade only if justified)

# Upgrade Gates — when to upgrade from skateboard ## Upgrade 1: SERP feature-aware planning (add SERP API) **Trigger:** you have ≥ 30 target queries/week and want better intent matching. **Adds:** For each target query, fetch top 10 SERP titles/snippets, classify intent, propose better outlines. ## Upgrade 2: Lead magnet detector + builder **Trigger:** dashboard shows traffic but low conversion, OR you want linkable assets. **Adds:** For each cluster, propose: - template pack, checklist, calculator, generator Plus a landing page + tracking events. ## Upgrade 3: Keyword universe mapping **Trigger:** you have stable refresh loop AND want systematic expansion. **Adds:** KE/DataForSEO harvesting → clustering → backlog generation. ## Upgrade 4: Programmatic pages at scale **Trigger:** you have repeatable page template and proven conversion per page type. **Adds:** strict QA gates, canonical rules, duplicate detection, sitemap integration. ## Upgrade 5: Competitor backlink intersection + outreach **Trigger:** you have link-worthy assets already and capacity for human review. **Adds:** prospect list + drafted emails, but keep send human-in-loop. 

integration/website-integration.md (agent instructions)

# Website Integration — Agent Instructions (Replit-friendly) ## Goal Add: 1) a server route/page that renders the dashboard 2) a way to run the controller on a schedule 3) safe config via .env 4) a place to store SQLite ## Step-by-step (agent) 1) Identify website framework: - Next.js / Astro / Express / Django / etc. 2) Implement a dashboard endpoint: - GET /seo-flywheel - reads from SQLite - renders HTML table/cards with metrics 3) Add controller runner: - CLI command `npm run seo:daily` OR `python seo_controller.py --daily` 4) Add scheduling: - In Replit: use a scheduled job OR external cron (GitHub Actions) OR uptime pinger hitting `/seo-flywheel/run` 5) Add “ping user” fallback: - If GSC API isn’t set up, controller generates TODOs shown on dashboard: - “Export GSC performance report and upload to /data/gsc.jsonl” 6) Make it observable: - Dashboard includes last_run, processed, published, skipped, errors, top uplift 7) Confirm end-to-end: - Run in `stub` mode first - Validate dashboard displays results - Switch to `pr` mode, confirm PR created - Switch to `publish` only after successful PR cycles ## Suggested integration patterns - If site is Next.js: - `/app/seo-flywheel/page.tsx` reads from SQLite - `/app/api/seo-flywheel/run/route.ts` triggers daily run (auth protected) - If site is Astro: - `/src/pages/seo-flywheel.astro` - `/src/pages/api/seo-flywheel/run.ts` - If site is Express: - `GET /seo-flywheel` renders dashboard - `POST /seo-flywheel/run` triggers jobs 

dashboard/dashboard.spec.md

# Dashboard Spec — /seo-flywheel ## Purpose Make the flywheel observable so you can trust it and decide when to upgrade. ## Must show (skateboard) - Last run: timestamp, duration - Run summary (last 7 days): - opportunities found - pages planned - pages published - pages skipped (cooldown/no change) - errors - Top uplift (weekly): - page URL - baseline clicks → current clicks - baseline impressions → current impressions - baseline position → current position - Action log (last 50): - time, type, page, status, short result ## Nice-to-have - Filters: date range, status, page contains… - “Pin this page next run” button - “Switch mode” (stub/todo/pr/publish) with confirmation 

