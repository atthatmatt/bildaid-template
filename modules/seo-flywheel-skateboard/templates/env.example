# --- Core ---
SITE_BASE_URL=https://example.com
SEO_DB_PATH=./data/seo_controller.sqlite
MODE=stub                    # stub | todo | pr | publish

# --- GSC Adapter (choose one) ---
GSC_MODE=export_file         # export_file | api | warehouse
GSC_EXPORT_PATH=./data/gsc_last_28_days.jsonl

# If api:
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=sc-domain:example.com

# --- CMS Adapter (choose one) ---
CMS_MODE=stub                # stub | wordpress | contentful | webflow | github_pr
CMS_BASE_URL=
CMS_TOKEN=

# --- Selection Criteria ---
MIN_IMPRESSIONS=10
POSITION_MIN=8
POSITION_MAX=20
MAX_PAGES_PER_RUN=5
COOLDOWN_DAYS=7

# --- Dashboard ---
DASHBOARD_AUTH=none           # none | basic | api_key
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_API_KEY=
